# cocarr-notification-service — environment
NODE_ENV=production
PORT=3070

# --- Database (MySQL) --------------------------------------------------------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=cocarr_core
DB_USER=cocarr
DB_PASS=change-me

CORS_ORIGINS=https://admin.cocarr.com

# --- Channels (each SIMULATES when unset, so dev works without providers) -----
# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@cocarr.com
# SMS (MSG91)
MSG_KEY=
MSG91_SENDER=COCARR
# Push (Firebase Cloud Messaging) + JWT verification
ADMIN_SERVICE_ACCOUNT=

# --- Dev-only auth escape hatch (NEVER true in production) --------------------
AUTH_DISABLED=false
